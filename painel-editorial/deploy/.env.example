# Painel editorial MAFRA LABS — variáveis do servidor (arquivo .env na VPS, chmod 600).
# Nenhum destes valores vai para o navegador. Não versione o .env real.

# Segredo de assinatura das sessões (mínimo 32 caracteres). Gerar: openssl rand -base64 48
PAINEL_SESSION_SECRET=

# Usuários do painel: JSON em base64 (evita problemas de aspas). Contém hashes scrypt, nunca senhas.
# Formato do JSON (antes do base64):
# [{"usuario":"marcos","nome":"Marcos Mafra","ator_id":"marcos_mafra","papel":"editor_responsavel",
#   "cliente_id":"altovaletopteam_com_br","senha_hash":"scrypt$...","ativo":true,"ambientes":["producao","teste"]}]
# Use ./painelctl.sh definir-senha <usuario> para criar/atualizar o hash.
PAINEL_USUARIOS_B64=

# Adaptador autenticado no n8n (rede Docker interna). O token é o mesmo da credencial
# "Painel editorial - token do adaptador" (Header Auth, cabeçalho X-Painel-Token) no n8n.
N8N_ADAPTADOR_URL=http://n8n:5678/webhook/painel-editorial/v1
N8N_ADAPTADOR_TOKEN=
N8N_ADAPTADOR_TIMEOUT_MS=45000

# Duração da sessão em horas (1 a 72).
PAINEL_SESSAO_HORAS=12

# true quando o painel for servido por HTTPS; false para acesso via túnel SSH em http://localhost.
PAINEL_COOKIE_SECURE=false

# Modo demonstração com dados fictícios no navegador. Mantenha 0 em produção.
PAINEL_DEMO=0
