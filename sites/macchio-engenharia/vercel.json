{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/sobre",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/sobre/",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/servicos",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/servicos/",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/contato",
      "destination": "/#contato",
      "permanent": true
    },
    {
      "source": "/contato/",
      "destination": "/#contato",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/#projetos",
      "permanent": true
    },
    {
      "source": "/portfolio/",
      "destination": "/#projetos",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug*",
      "destination": "/#projetos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
